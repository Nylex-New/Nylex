---
import QuantumMatrix from "~react/widgets/quantum-matrix";
import ISTClock from "~react/widgets/ist-clock";
import RevealHeading from "../ui/reaveal-heading.astro";
import { ArrowDownRight, Sparkles, Code2, Palette, Smartphone, Compass } from "lucide-react";

const servicesList = [
  { name: "UI/UX Design", icon: Palette },
  { name: "Web Development", icon: Code2 },
  { name: "Mobile Apps", icon: Smartphone },
  { name: "Branding", icon: Compass },
];

const marqueeItems = [
  "UI/UX Design",
  "Web Development",
  "Mobile Apps",
  "Branding",
  "Creative Agency",
  "Custom Applications",
  "Performance Engineering",
  "Design Systems",
];
---

<section
  id="home"
  class="relative min-h-screen w-full flex flex-col justify-between pt-28 pb-10 px-6 md:px-12 overflow-hidden"
>
  <!-- 3D Interactive Quantum Matrix & Gravitational Warp Field Background -->
  <QuantumMatrix client:only="react" />



  <!-- Center Content -->
  <div class="my-auto py-12 flex flex-col items-center text-center max-w-5xl mx-auto z-10">

    <!-- Main Title with Sweep Reveal -->
    <h1
      id="hero-title"
      class="text-4xl sm:text-6xl md:text-8xl lg:text-9xl font-black uppercase tracking-tight flex flex-col items-center gap-1 md:gap-3 leading-none"
    >
      <RevealHeading>NYLEX STUDIO</RevealHeading>
    </h1>

    <!-- Punchy Tagline -->
    <p class="text-xl sm:text-2xl md:text-3xl font-light tracking-wide mt-6 opacity-90">
      Building Premium Digital Experiences.
    </p>

    <!-- Tri-Pillar Motto -->
    <p class="text-base sm:text-lg md:text-xl font-mono uppercase tracking-widest text-[#0052FF] mt-2 font-medium">
      We Design. We Develop. We Deliver.
    </p>

    <!-- Narrative Description -->
    <p class="text-base sm:text-lg text-balance max-w-2xl mt-5 opacity-70 leading-relaxed font-normal">
      Nylex is a creative digital studio crafting premium websites, brands, and digital products that help modern businesses establish authority and scale.
    </p>



    <!-- Action Buttons -->
    <div id="hero-actions" class="flex flex-wrap items-center justify-center gap-4 mt-10">
      <a
        href="#works"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-[#0052FF] text-white font-semibold text-sm sm:text-base hover:bg-[#2563EB] hover:scale-105 active:scale-95 transition-all shadow-[0_0_25px_rgba(0,82,255,0.35)]"
      >
        <span>Explore Work</span>
        <ArrowDownRight className="size-4" />
      </a>
      <a
        href="#solutions"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full border border-current/25 hover:border-[#0052FF] bg-background/50 backdrop-blur-sm text-foreground hover:text-[#0052FF] font-semibold text-sm sm:text-base hover:scale-105 active:scale-95 transition-all"
      >
        <span>Services</span>
      </a>
    </div>
  </div>

  <!-- Scrolling Marquee Bar -->
  <div class="w-full overflow-hidden border-y border-current/10 py-3.5 my-4 select-none relative">
    <div class="flex items-center gap-8 whitespace-nowrap animate-marquee">
      {[...marqueeItems, ...marqueeItems, ...marqueeItems].map((item) => (
        <div class="flex items-center gap-8 font-mono text-xs sm:text-sm uppercase tracking-widest opacity-80">
          <span>{item}</span>
          <span class="w-1.5 h-1.5 rounded-full bg-[#0052FF]"></span>
        </div>
      ))}
    </div>
  </div>

</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: inline-flex;
    animation: marquee 25s linear infinite;
    will-change: transform;
  }
  .animate-marquee:hover {
    animation-play-state: paused;
  }
</style>

<script>
  import { gsap } from "gsap";

  document.addEventListener("astro:page-load", () => {
    gsap.fromTo(
      "#hero-badge",
      { opacity: 0, y: -20 },
      { opacity: 1, y: 0, duration: 0.8, delay: 0.2, ease: "power2.out" }
    );
    gsap.fromTo(
      "#hero-actions",
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8, delay: 0.6, ease: "power2.out" }
    );
  });
</script>

