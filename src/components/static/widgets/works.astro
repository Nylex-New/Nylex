---
import WorksGrid from "./works-grid.astro";
---

<section
  id="works"
  class="w-full py-28 md:py-36 px-6 md:px-12 lg:px-20 border-t border-neutral-200 relative bg-white text-neutral-950"
>
  <div class="max-w-4xl mb-10 sm:mb-14">
    <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.25em] text-[#0052FF] font-semibold mb-4">
      <span class="w-2 h-2 rounded-full bg-[#0052FF]"></span>
      <span>OUR WORK</span>
    </div>
    <h2 class="text-4xl sm:text-6xl lg:text-7xl font-bold uppercase tracking-tight leading-none text-neutral-950">
      Projects That Speak for Us
    </h2>
  </div>

  <!-- Ultra-clean project showcase: Only Photo, Name, Description, Link Button -->
  <WorksGrid />
</section>
