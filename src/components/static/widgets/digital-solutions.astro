---
import { ArrowUpRight } from "lucide-react";

const solutions = [
  {
    num: "01",
    title: "Web Development",
    subtitle: "High-Performance Architecture & Custom Engineering",
    description:
      "Custom websites built with modern technologies for performance, scalability and growth. We engineer resilient frontends and robust backends designed to convert visitors, load in milliseconds, and scale effortlessly.",
    capabilities: [
      "Headless & Edge Architecture",
      "Next.js & Astro Platforms",
      "Interactive 3D / WebGL Experiences",
      "Search Engine Authority & Core Web Vitals",
    ],
  },
  {
    num: "02",
    title: "UI/UX Design",
    subtitle: "Intuitive Human Interfaces & Visual Systems",
    description:
      "Beautiful, user-friendly designs that create strong first impressions and engage users. We turn complex business workflows into seamless, elegant digital journeys that users love and trust.",
    capabilities: [
      "User Journey & Interaction Mapping",
      "Comprehensive Design Systems",
      "High-Fidelity Interactive Prototypes",
      "Conversion Rate Optimization (CRO)",
    ],
  },
  {
    num: "03",
    title: "Mobile Development",
    subtitle: "Native-Grade Cross-Platform Applications",
    description:
      "Cross-platform mobile apps that deliver seamless experiences on any device. Flawless ergonomics, instant offline access, and fluid 60-120 FPS animations on both iOS and Android.",
    capabilities: [
      "Cross-Platform Native (React Native / Flutter)",
      "Real-Time Data Synchronization",
      "Offline-First Edge Architecture",
      "App Store & Play Store Lifecycle",
    ],
  },
  {
    num: "04",
    title: "Branding",
    subtitle: "Distinctive Visual Identities & Market Positioning",
    description:
      "Unique brand identities that communicate your value and build lasting trust. From typography and color theory to comprehensive brand guidelines that set you apart in crowded global markets.",
    capabilities: [
      "Brand Positioning & Visual Voice",
      "Vector Logomarks & Typography",
      "Scalable Digital Brand Guidelines",
      "Marketing & Pitch Deck Collaterals",
    ],
  },
];
---

<section
  id="solutions"
  class="w-full py-28 md:py-36 px-6 md:px-12 lg:px-20 border-t border-neutral-200/50 relative bg-transparent text-neutral-950 overflow-hidden"
>
  <!-- Background Glow Orb -->
  <div class="absolute top-1/4 right-0 w-[500px] h-[500px] bg-[#0052FF]/[0.04] rounded-full blur-[140px] pointer-events-none -z-10" />

  <!-- Section Editorial Header -->
  <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-8 mb-20 md:mb-28">
    <div class="max-w-3xl">
      <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-[0.25em] text-[#0052FF] font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-[#0052FF]"></span>
        <span>WHAT WE DO</span>
      </div>
      <h2 class="text-4xl sm:text-6xl lg:text-7xl font-bold uppercase tracking-tight leading-none text-neutral-950">
        Digital Solutions
      </h2>
      <p class="text-lg sm:text-xl md:text-2xl text-neutral-600 mt-5 leading-relaxed font-light text-balance">
        We build state-of-the-art websites, brands and custom applications that load instantly and perform flawlessly.
      </p>
    </div>

    <!-- Minimalist Architectural Button -->
    <a
      href="#contact"
      class="group inline-flex items-center gap-3 px-8 py-4 rounded-full border border-neutral-300 hover:border-[#0052FF] bg-neutral-50 hover:bg-[#0052FF] text-neutral-900 hover:text-white font-mono text-xs uppercase tracking-widest transition-all duration-300 shrink-0"
    >
      <span>Start a Project</span>
      <ArrowUpRight className="size-4 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
    </a>
  </div>

  <!-- Editorial Monolithic Service Rows (Alternating Layout: 1 & 3 Left Heading, 2 & 4 Right Heading) -->
  <div class="w-full border-t border-neutral-200 divide-y divide-neutral-200">
    {solutions.map((item, idx) => {
      const isReversed = idx % 2 === 1; // 2nd and 4th items have Heading on Right, Description on Left
      return (
        <div class="service-row group py-12 md:py-16 transition-all duration-500 hover:bg-[#0052FF]/[0.02] px-2 md:px-8 rounded-2xl relative">
          <!-- Hover Blue Indicator Bar -->
          <div class={`absolute ${isReversed ? "right-0" : "left-0"} top-0 bottom-0 w-[3px] bg-[#0052FF] scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-center rounded-full`} />

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            <!-- Number Column -->
            <div class={`order-1 ${isReversed ? "lg:col-span-2 lg:order-2" : "lg:col-span-2 lg:order-1"}`}>
              <span class="font-mono text-2xl md:text-4xl font-light text-neutral-300 group-hover:text-[#0052FF] transition-all duration-300">
                {item.num}
              </span>
            </div>

            <!-- Title & Subtitle Column -->
            <div class={`order-2 lg:col-span-5 flex flex-col ${isReversed ? "lg:order-3" : "lg:order-2"}`}>
              <h3 class="text-3xl sm:text-4xl md:text-5xl font-bold uppercase tracking-tight text-neutral-950 group-hover:text-[#0052FF] transition-colors duration-300">
                {item.title}
              </h3>
              <span class="font-mono text-xs uppercase tracking-wider text-neutral-500 mt-2 font-normal">
                {item.subtitle}
              </span>
            </div>

            <!-- Description & Clean Scope Points Column -->
            <div class={`order-3 lg:col-span-5 flex flex-col justify-between gap-6 ${isReversed ? "lg:order-1" : "lg:order-3"}`}>
              <p class="text-base sm:text-lg text-neutral-600 leading-relaxed font-light">
                {item.description}
              </p>

              <!-- Minimal Scope List -->
              <div class="pt-4 border-t border-neutral-200/80 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-neutral-600">
                {item.capabilities.map((cap) => (
                  <div class="flex items-center gap-2">
                    <span class="w-1 h-1 rounded-full bg-[#0052FF]"></span>
                    <span>{cap}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { applyScrollReveal } from "@/lib/animations";

  gsap.registerPlugin(ScrollTrigger);

  const initSolutionsThemeTransition = () => {
    applyScrollReveal(".service-row");

    // Dynamic scroll-driven background transition (Black to White) as documented in HERO_AND_BACKGROUND_EFFECTS.md
    gsap.fromTo(
      "body",
      {
        backgroundColor: "#08090f",
        color: "#ffffff",
      },
      {
        backgroundColor: "#ffffff",
        color: "#0a0a0a",
        ease: "none",
        scrollTrigger: {
          trigger: "#solutions",
          start: "top 75%",  // Animation starts when WHAT WE DO enters 75% down viewport
          end: "top 20%",    // Fully turns pure white as WHAT WE DO reaches 20%
          scrub: true,       // Linked directly to scroll velocity
          invalidateOnRefresh: true,
        },
      }
    );
  };

  document.addEventListener("astro:page-load", initSolutionsThemeTransition);
  if (document.readyState === "complete" || document.readyState === "interactive") {
    initSolutionsThemeTransition();
  }
</script>
