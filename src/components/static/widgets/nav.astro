---
import Logo from "../ui/logo.astro";
import { LetsTalkButton } from "@/components/react/widgets/lets-talk-button";
import { ArrowUpRight } from "lucide-react";
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 w-full z-50 flex items-center justify-between px-6 md:px-12 py-5 transition-all duration-300 backdrop-blur-md bg-background/60 border-b border-foreground/5"
>
  <a href="#home" class="relative z-50 group flex items-center">
    <Logo />
  </a>

  <!-- Desktop Nav Links -->
  <div class="hidden md:flex items-center gap-7 text-xs uppercase tracking-[0.2em] font-mono font-medium">
    <a
      href="#works"
      class="opacity-70 hover:opacity-100 hover:text-[#0052FF] transition-all hover:-translate-y-0.5"
    >
      Our Work
    </a>
    <a
      href="#solutions"
      class="opacity-70 hover:opacity-100 hover:text-[#0052FF] transition-all hover:-translate-y-0.5"
    >
      Solutions
    </a>
    <a
      href="#reviews"
      class="opacity-70 hover:opacity-100 hover:text-[#0052FF] transition-all hover:-translate-y-0.5"
    >
      Reviews
    </a>
    <a
      href="#about"
      class="opacity-70 hover:opacity-100 hover:text-[#0052FF] transition-all hover:-translate-y-0.5"
    >
      About Us
    </a>
    <a
      href="#contact"
      class="opacity-70 hover:opacity-100 hover:text-[#0052FF] transition-all hover:-translate-y-0.5"
    >
      Contact
    </a>
  </div>

  <div class="flex items-center gap-4 relative z-50">
    <div class="hidden sm:block">
      <LetsTalkButton client:load className="px-5 py-2" />
    </div>

    <!-- Mobile Menu Toggle Button -->
    <button
      id="mobile-nav-toggle"
      aria-label="Toggle navigation menu"
      class="md:hidden p-2 rounded-lg border border-foreground/15 bg-background/80 text-foreground cursor-pointer"
    >
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-nav-menu"
    class="fixed inset-0 top-[73px] bg-background/95 backdrop-blur-2xl flex flex-col justify-start px-8 pt-10 pb-8 gap-5 md:hidden transition-all duration-300 -translate-y-full opacity-0 pointer-events-none border-b border-foreground/10"
  >
    <a
      href="#works"
      class="mobile-nav-link text-xl font-bold uppercase tracking-wide border-b border-foreground/10 pb-3"
    >
      Our Work
    </a>
    <a
      href="#solutions"
      class="mobile-nav-link text-xl font-bold uppercase tracking-wide border-b border-foreground/10 pb-3"
    >
      Digital Solutions
    </a>
    <a
      href="#reviews"
      class="mobile-nav-link text-xl font-bold uppercase tracking-wide border-b border-foreground/10 pb-3"
    >
      Client Reviews
    </a>
    <a
      href="#about"
      class="mobile-nav-link text-xl font-bold uppercase tracking-wide border-b border-foreground/10 pb-3"
    >
      About Us
    </a>
    <a
      href="#contact"
      class="mobile-nav-link text-xl font-bold uppercase tracking-wide border-b border-foreground/10 pb-3"
    >
      Contact
    </a>

    <div class="pt-4">
      <a
        href="https://wa.me/918921442748"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-4 rounded-xl bg-[#0052FF] text-white font-semibold text-center"
      >
        Chat on WhatsApp <ArrowUpRight className="size-5" />
      </a>
    </div>
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById("mobile-nav-toggle");
  const menu = document.getElementById("mobile-nav-menu");
  const hamburger = document.getElementById("hamburger-icon");
  const closeIcon = document.getElementById("close-icon");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");

  let isOpen = false;

  const toggleMenu = () => {
    isOpen = !isOpen;
    if (isOpen) {
      menu?.classList.remove("-translate-y-full", "opacity-0", "pointer-events-none");
      menu?.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
      hamburger?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    } else {
      menu?.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
      menu?.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
      hamburger?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      document.body.style.overflow = "";
    }
  };

  toggleBtn?.addEventListener("click", toggleMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", () => {
      if (isOpen) toggleMenu();
    });
  });

  // Zero-reflow dynamic light/dark theme detector via IntersectionObserver (Zero scroll listeners)
  const mainNav = document.getElementById("main-nav");
  const whiteWrapper = document.getElementById("white-theme-wrapper");

  if (whiteWrapper && mainNav) {
    const navObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            mainNav.classList.add("is-light-nav");
          } else {
            mainNav.classList.remove("is-light-nav");
          }
        });
      },
      {
        rootMargin: "-65px 0px 0px 0px",
        threshold: 0,
      }
    );
    navObserver.observe(whiteWrapper);

    document.addEventListener(
      "astro:before-swap",
      () => {
        navObserver.disconnect();
      },
      { once: true }
    );
  }
</script>

<style>
  #main-nav {
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  #main-nav.is-light-nav {
    background-color: rgba(255, 255, 255, 0.9);
    border-bottom-color: rgba(0, 0, 0, 0.08);
    color: #0a0a0a;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
  }
  #main-nav.is-light-nav a {
    color: #171717;
  }
  #main-nav.is-light-nav a:hover {
    color: #0052FF;
  }
  #main-nav.is-light-nav button#mobile-nav-toggle {
    border-color: rgba(0, 0, 0, 0.15);
    background-color: rgba(255, 255, 255, 0.95);
    color: #0a0a0a;
  }
</style>
