---
import ContactForm from "@/components/react/widgets/contact-form";
import contacts from "@/data/contacts.json";
import { ArrowUpRight, Mail, Phone, MapPin, Clock } from "lucide-react";
---

<section
  id="contact"
  class="w-full py-28 md:py-36 px-6 md:px-12 lg:px-20 border-t border-neutral-200 relative bg-white text-neutral-950"
>
  <div class="max-w-7xl mx-auto">
    <!-- Header (Editorial Style) -->
    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-end gap-8 pb-16 border-b border-neutral-200 mb-16">
      <div class="max-w-3xl">
        <div class="flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.25em] text-[#0052FF] font-semibold mb-4">
          <span class="w-2 h-2 rounded-full bg-[#0052FF]"></span>
          <span>INITIATE ENGAGEMENT</span>
        </div>
        <h2 class="text-4xl sm:text-6xl lg:text-7xl font-bold uppercase tracking-tight leading-none text-neutral-950">
          Start Your Project
        </h2>
      </div>

      <div class="flex flex-col gap-1 font-mono text-xs text-neutral-500 max-w-sm">
        <span>Technical Directors on standby.</span>
        <span class="text-[#0052FF] font-medium">Guaranteed initial response within 24 hours.</span>
      </div>
    </div>

    <!-- Main Grid: Form + Communication Desks (Zero Shadows, Clean Hairlines) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Contact Form Column -->
      <div class="lg:col-span-7 rounded-2xl border border-neutral-200 bg-neutral-50/50 p-6 sm:p-10 md:p-12">
        <ContactForm client:visible />
      </div>

      <!-- Direct Studio Desks Column (Zero Shadows) -->
      <div class="lg:col-span-5 flex flex-col gap-5">
        <!-- WhatsApp Primary Desk -->
        <a
          href={contacts.whatsapp.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group p-8 rounded-2xl border border-[#0052FF]/30 hover:border-[#0052FF] bg-[#0052FF]/[0.02] hover:bg-[#0052FF]/[0.05] transition-all flex flex-col justify-between"
        >
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-[#0052FF] uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-[#0052FF] animate-pulse"></span>
              Fast-Response Channel
            </span>
            <div class="p-2.5 rounded-full border border-[#0052FF]/30 text-[#0052FF] group-hover:border-[#0052FF] group-hover:bg-[#0052FF] group-hover:text-white transition-all">
              <ArrowUpRight className="size-4" />
            </div>
          </div>

          <div class="mt-8">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-neutral-950">
              Chat on WhatsApp
            </h3>
            <p class="text-sm text-neutral-600 mt-2 leading-relaxed font-light">
              Direct line to our technical directors. Ideal for rapid architectural discovery, quick quotes, or scheduling a technical call.
            </p>
          </div>

          <div class="mt-8 pt-5 border-t border-neutral-200 font-mono text-xs uppercase tracking-wider flex items-center justify-between">
            <span class="text-neutral-950 font-semibold">{contacts.phone.display}</span>
            <span class="text-[#0052FF] group-hover:translate-x-1 transition-transform">Instant Connect &rarr;</span>
          </div>
        </a>

        <!-- Direct Email Desk -->
        <a
          href={contacts.email.href}
          class="group p-6 rounded-2xl border border-neutral-200 bg-white hover:border-[#0052FF] transition-all flex items-center gap-5"
        >
          <div class="p-3.5 rounded-xl border border-neutral-200 bg-neutral-50 text-[#0052FF] group-hover:border-[#0052FF] transition-colors shrink-0">
            <Mail className="size-5" />
          </div>
          <div class="overflow-hidden">
            <span class="font-mono text-[10px] text-neutral-400 uppercase tracking-widest block">Direct Inbox</span>
            <span class="font-mono text-sm sm:text-base font-semibold text-neutral-950 truncate block mt-0.5 group-hover:text-[#0052FF] transition-colors">
              {contacts.email.address}
            </span>
          </div>
        </a>

        <!-- Direct Telephone Desk -->
        <a
          href={contacts.phone.href}
          class="group p-6 rounded-2xl border border-neutral-200 bg-white hover:border-[#0052FF] transition-all flex items-center gap-5"
        >
          <div class="p-3.5 rounded-xl border border-neutral-200 bg-neutral-50 text-[#0052FF] group-hover:border-[#0052FF] transition-colors shrink-0">
            <Phone className="size-5" />
          </div>
          <div>
            <span class="font-mono text-[10px] text-neutral-400 uppercase tracking-widest block">Direct Line</span>
            <span class="font-mono text-sm sm:text-base font-semibold text-neutral-950 block mt-0.5 group-hover:text-[#0052FF] transition-colors">
              {contacts.phone.display}
            </span>
          </div>
        </a>

        <!-- Physical Studio Location Desk -->
        <div class="p-6 rounded-2xl border border-neutral-200 bg-white flex items-center gap-5">
          <div class="p-3.5 rounded-xl border border-neutral-200 bg-neutral-50 text-[#0052FF] shrink-0">
            <MapPin className="size-5" />
          </div>
          <div>
            <span class="font-mono text-[10px] text-neutral-400 uppercase tracking-widest block">Headquarters</span>
            <span class="font-medium text-sm sm:text-base block mt-0.5 text-neutral-900">
              {contacts.location}
            </span>
          </div>
        </div>

        <!-- SLA Protocol -->
        <div class="p-4 rounded-xl border border-neutral-200 bg-neutral-50 flex items-center gap-3 text-xs font-mono text-neutral-600">
          <Clock className="size-3.5 text-[#0052FF] shrink-0" />
          <span>Strict 24h SLA protocol &bull; Full IP Protection &amp; NDA</span>
        </div>
      </div>
    </div>
  </div>
</section>
